{
  "name": "linkding-toolbar-companion",
  "version": "1.0.6",
  "private": true,
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "build:firefox": "vite build --mode firefox",
    "build:chrome": "vite build --mode chrome",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint .",
    "lint:firefox": "npm run build:firefox && node scripts/firefox-manifest-override.js && web-ext lint --source-dir dist-firefox",
    "start:firefox": "npm run build:firefox && node scripts/firefox-manifest-override.js && web-ext run --source-dir dist-firefox",
    "package:source": "bash scripts/package-source.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.44.0",
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/webextension-polyfill": "^0.10.7",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.3.1",
    "vitest": "^1.6.0",
    "web-ext": "^10.6.0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "webextension-polyfill": "^0.12.0"
  }
}
